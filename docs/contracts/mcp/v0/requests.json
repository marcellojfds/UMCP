{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-memory.protocol/contracts/mcp/v0/requests.json",
  "$defs": {
    "MemoryType": { "type": "string", "enum": ["fact", "preference", "decision", "insight", "hypothesis", "lesson", "goal", "project_context", "concept", "relationship", "open_question"] },
    "MemoryState": { "type": "string", "enum": ["active", "superseded", "contradicted", "archived"] },
    "Provenance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source_type": { "type": "string", "enum": ["conversation", "user", "agent", "import", "system", "unknown", "other"] },
        "captured_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "source_id": { "type": ["string", "null"], "maxLength": 256 },
        "source_model": { "type": ["string", "null"], "maxLength": 128 },
        "evidence": { "type": ["string", "null"], "maxLength": 2000 }
      },
      "required": ["source_type", "captured_at"]
    },
    "MemoryPatch": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "content": { "type": ["string", "null"], "minLength": 1, "maxLength": 16384 },
        "type": { "$ref": "#/$defs/MemoryType" },
        "space": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "importance": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "state": { "$ref": "#/$defs/MemoryState" },
        "provenance": { "anyOf": [{ "$ref": "#/$defs/Provenance" }, { "type": "null" }] }
      }
    },
    "WriteRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "content": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "type": { "$ref": "#/$defs/MemoryType" },
        "owner_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "space": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "importance": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 2500 }
      },
      "required": ["content", "type", "owner_id", "provenance", "idempotency_key"]
    },
    "SearchRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "owner_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "space": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "type": { "anyOf": [{ "$ref": "#/$defs/MemoryType" }, { "type": "null" }] },
        "state": { "anyOf": [{ "$ref": "#/$defs/MemoryState" }, { "type": "null" }] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
        "min_relevance": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.78 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 2500 }
      },
      "required": ["query", "owner_id"]
    },
    "UpdateRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "owner_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expected_version": { "type": "integer", "minimum": 1 },
        "patch": { "$ref": "#/$defs/MemoryPatch" },
        "provenance": { "anyOf": [{ "$ref": "#/$defs/Provenance" }, { "type": "null" }] },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 2500 }
      },
      "required": ["id", "owner_id", "expected_version", "patch", "idempotency_key"]
    },
    "ForgetRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "owner_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": ["string", "null"], "maxLength": 256 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 2500 }
      },
      "required": ["id", "owner_id", "idempotency_key"]
    }
  }
}
