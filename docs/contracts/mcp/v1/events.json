{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-memory.protocol/contracts/mcp/v1/events.json",
  "$defs": {
    "ConnectionRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "connection_id", "revoked_at", "reason"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event-[a-z0-9-]+$"},
        "event_type": {"const": "connection.revoked"},
        "connection_id": {"type": "string", "pattern": "^conn-[a-z0-9-]+$"},
        "revoked_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "enum": ["user_requested_revocation"]}
      }
    }
  }
}
