#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: scripts/assert-worktree-context [--expected-head SHA] [--require-clean]

The expected path and branch are intentionally fixed for the Verification lane:
  /private/tmp/umcp-roadmap-verification
  roadmap/luna-verification
EOF
  exit 2
}

expected_path="/private/tmp/umcp-roadmap-verification"
expected_branch="roadmap/luna-verification"
expected_head=""
require_clean=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --expected-head)
      [[ $# -ge 2 ]] || usage
      expected_head="$2"
      shift 2
      ;;
    --require-clean)
      require_clean=1
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

actual_path="$(pwd -P)"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "worktree context failed: not inside a Git worktree" >&2
  exit 1
}
repo_root="$(cd "$repo_root" && pwd -P)"
actual_branch="$(git branch --show-current)"
actual_head="$(git rev-parse HEAD)"
status_lines="$(git status --short --branch)"

printf 'worktree=%s\n' "$actual_path"
printf 'repo_root=%s\n' "$repo_root"
printf 'branch=%s\n' "$actual_branch"
printf 'head=%s\n' "$actual_head"
printf 'status=%s\n' "${status_lines//$'\n'/ | }"

failed=0
if [[ "$actual_path" != "$expected_path" || "$repo_root" != "$expected_path" ]]; then
  echo "worktree context failed: expected path $expected_path" >&2
  failed=1
fi
if [[ "$actual_branch" != "$expected_branch" ]]; then
  echo "worktree context failed: expected branch $expected_branch" >&2
  failed=1
fi
if [[ -n "$expected_head" && "$actual_head" != "$expected_head" ]]; then
  echo "worktree context failed: expected HEAD $expected_head, found $actual_head" >&2
  failed=1
fi
if [[ "$require_clean" == "1" && -n "$(git status --porcelain)" ]]; then
  echo "worktree context failed: worktree is not clean" >&2
  failed=1
fi
if ! git worktree list --porcelain | awk -v expected="$expected_path" '
  $1 == "worktree" && $2 == expected { found = 1 }
  END { exit(found ? 0 : 1) }
'; then
  echo "worktree context failed: expected path is absent from git worktree list" >&2
  failed=1
fi

if [[ "$failed" != "0" ]]; then
  exit 1
fi
echo "worktree context passed"
