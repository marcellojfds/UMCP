#!/usr/bin/env bash
set -euo pipefail

if ! command -v pip-audit >/dev/null 2>&1; then
  echo "pip-audit is required for the dependency gate; install it in the isolated audit environment" >&2
  exit 2
fi

# Audit the dependency graph declared by this project.  Auditing the ambient
# interpreter can report unrelated tools from a developer machine instead.
pip-audit --strict .
