#!/usr/bin/env bash
set -euo pipefail

# Logical backup for a self-hosted operator. The destination must be outside
# the repository and protected like the source database.
if [[ "$#" -ne 1 || -z "${OMP_DATABASE_URL:-}" ]]; then
  echo "usage: OMP_DATABASE_URL=postgresql://... $0 /secure/path/omp.dump" >&2
  exit 2
fi

destination="$1"
case "$destination" in
  *.dump) ;;
  *) echo "backup destination must end in .dump" >&2; exit 2 ;;
esac
umask 077
pg_dump --format=custom --no-owner --no-privileges --file="$destination" "$OMP_DATABASE_URL"
echo "backup created: $destination"
