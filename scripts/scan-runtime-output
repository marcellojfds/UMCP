#!/usr/bin/env bash
set -euo pipefail

# Scan ephemeral outputs before they become CI artifacts.  Do not print matches:
# a failing scan must not copy the sensitive byte back into the build log.
if [[ "$#" -eq 0 ]]; then
  echo "usage: scan-runtime-output PATH [PATH ...]" >&2
  exit 2
fi

patterns='(CANARY-(CONTENT|SECRET|PII)-[A-Za-z0-9_-]+|AKIA[0-9A-Z]{16}|-----BEGIN( [A-Z]+)? PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|AIza[0-9A-Za-z_-]{35})'
matches="$(grep -rIlE --exclude='*.pyc' -- "$patterns" "$@" 2>/dev/null || true)"
if [[ -n "$matches" ]]; then
  printf '%s\n' "$matches" >&2
  echo "sensitive canary or secret-shaped value found in runtime output" >&2
  exit 1
fi

echo "runtime-output scan passed"
