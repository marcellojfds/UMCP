#!/usr/bin/env python3
"""Atomically publish and inspect events in the shared UMCP agent board."""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
import re
import sys
from pathlib import Path

HEADER = """# UMCP Agent Board

This is the shared, append-only coordination mural for Codex sessions.

Rules:

- Git handoffs and tested SHAs are authoritative; a board event is a notification.
- Writers must use `scripts/agent-board publish` so concurrent updates are locked.
- Every event needs a stable idempotency key. Repeating the same event is safe.
- `DONE` means lane delivery; `VERIFIED` means independent evidence; `INTEGRATED`
  means the controlled integration handoff exists. None of these means release GO.

## Events

"""

STATUSES = {
    "WAITING",
    "READY",
    "CLAIMED",
    "IN_PROGRESS",
    "DONE",
    "VERIFIED",
    "INTEGRATED",
    "BLOCKED",
    "FAILED",
    "DISPATCHED",
}
EVENT_RE = re.compile(
    r"^- (?P<time>[^|]+) \| id=`(?P<id>[^`]+)` \| milestone=`(?P<milestone>[^`]+)` "
    r"\| lane=`(?P<lane>[^`]+)` \| agent=`(?P<agent>[^`]+)` "
    r"\| status=`(?P<status>[^`]+)` \| sha=`(?P<sha>[^`]*)` "
    r"\| evidence=`(?P<evidence>[^`]*)` \| message=(?P<message>.*)$"
)


def clean(value: str, field: str) -> str:
    value = value.strip()
    if not value:
        raise ValueError(f"{field} must not be empty")
    if any(character in value for character in "\n\r`|"):
        raise ValueError(f"{field} contains a forbidden character")
    return value


def board_lock(board: Path):
    board.parent.mkdir(parents=True, exist_ok=True)
    lock_path = board.with_suffix(board.suffix + ".lock")
    lock_file = lock_path.open("a+", encoding="utf-8")
    fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
    return lock_file


def initialize(board: Path) -> None:
    lock_file = board_lock(board)
    try:
        if not board.exists():
            board.write_text(HEADER, encoding="utf-8")
            with board.open("rb") as board_file:
                os.fsync(board_file.fileno())
    finally:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
        lock_file.close()


def parse_events(content: str) -> list[dict[str, str]]:
    events: list[dict[str, str]] = []
    for line in content.splitlines():
        match = EVENT_RE.match(line)
        if match:
            events.append(match.groupdict())
    return events


def publish(args: argparse.Namespace) -> int:
    board = args.board.resolve()
    event = {
        "id": clean(args.event_id, "event id"),
        "milestone": clean(args.milestone, "milestone"),
        "lane": clean(args.lane, "lane"),
        "agent": clean(args.agent, "agent"),
        "status": clean(args.status.upper(), "status"),
        "sha": args.sha.strip(),
        "evidence": args.evidence.strip(),
        "message": args.message.strip() or "-",
    }
    if event["status"] not in STATUSES:
        raise ValueError(f"unsupported status: {event['status']}")
    for field in ("sha", "evidence"):
        if any(character in event[field] for character in "\n\r`|"):
            raise ValueError(f"{field} contains a forbidden character")
    event["message"] = event["message"].replace("\n", " ").replace("\r", " ").replace("|", "/")

    lock_file = board_lock(board)
    try:
        if not board.exists():
            board.write_text(HEADER, encoding="utf-8")
        content = board.read_text(encoding="utf-8")
        existing = {item["id"]: item for item in parse_events(content)}
        if event["id"] in existing:
            comparable = {key: existing[event["id"]][key] for key in event}
            if comparable == event:
                print(f"event={event['id']} status=already-present")
                return 0
            print(f"event={event['id']} status=conflict", file=sys.stderr)
            return 3

        timestamp = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()
        line = (
            f"- {timestamp} | id=`{event['id']}` | milestone=`{event['milestone']}` "
            f"| lane=`{event['lane']}` | agent=`{event['agent']}` "
            f"| status=`{event['status']}` | sha=`{event['sha']}` "
            f"| evidence=`{event['evidence']}` | message={event['message']}\n"
        )
        with board.open("a", encoding="utf-8") as board_file:
            board_file.write(line)
            board_file.flush()
            os.fsync(board_file.fileno())
        print(f"event={event['id']} status=published")
        return 0
    finally:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
        lock_file.close()


def show(args: argparse.Namespace) -> int:
    board = args.board.resolve()
    if not board.exists():
        print(f"board not found: {board}", file=sys.stderr)
        return 2
    events = parse_events(board.read_text(encoding="utf-8"))
    if args.latest:
        latest: dict[str, dict[str, str]] = {}
        for event in events:
            latest[f"{event['milestone']}:{event['lane']}"] = event
        events = list(latest.values())
    if args.json:
        print(json.dumps(events, indent=2, sort_keys=True))
    else:
        print(board.read_text(encoding="utf-8"), end="")
    return 0


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser()
    root.add_argument("--board", type=Path, required=True)
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("init")

    publish_parser = commands.add_parser("publish")
    publish_parser.add_argument("--event-id", required=True)
    publish_parser.add_argument("--milestone", required=True)
    publish_parser.add_argument("--lane", required=True)
    publish_parser.add_argument("--agent", required=True)
    publish_parser.add_argument("--status", required=True)
    publish_parser.add_argument("--sha", default="")
    publish_parser.add_argument("--evidence", default="")
    publish_parser.add_argument("--message", default="")

    show_parser = commands.add_parser("show")
    show_parser.add_argument("--json", action="store_true")
    show_parser.add_argument("--latest", action="store_true")
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "init":
            initialize(args.board.resolve())
            print(f"board={args.board.resolve()} status=initialized")
            return 0
        if args.command == "publish":
            return publish(args)
        if args.command == "show":
            return show(args)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2
    raise AssertionError("unreachable")


if __name__ == "__main__":
    raise SystemExit(main())
